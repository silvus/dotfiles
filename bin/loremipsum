#!/usr/bin/env bash

# Wrapper for the lorem script
# ----------------------------

# Check requirements
if [[ ! -x "$(command -v lorem 2>/dev/null)" ]]; then
	echo "lorem script is not installed."
	exit 1
fi

# copy handles Wayland (wl-copy) and X11 (xclip)
lorem --randomize --words 50 --cols 2000 | copy

