def syncthing(*args: str) -> list[str]:
    """Build a `syncthing cli` command."""
    return ["syncthing", "cli", *args]


def run_query_command(
    cmd: list[str], check: bool = True
) -> subprocess.CompletedProcess[str]:
    """Execute a command for querying information."""
    log.debug(f"Running query command: {shlex.join(cmd)}")
    try:
        result = subprocess.run(cmd, check=check, capture_output=True, text=True)
        if result.stdout.strip():
            log.debug(f"stdout: {result.stdout.strip()}")
        if result.stderr.strip():
            log.debug(f"stderr: {result.stderr.strip()}")
        return result
    except subprocess.CalledProcessError as e:
        log.error(f"Query command failed: {shlex.join(cmd)}")
        log.error(f"Exit code: {e.returncode}")
        stderr = cast(str | None, e.stderr)
        if stderr and stderr.strip():
            log.error(f"stderr: {stderr.strip()}")
        raise


def run_modify_command(
    cmd: list[str], check: bool = True, display: str | None = None
) -> None:
    """Execute a command that modifies configuration.

    `display` replaces the command in logs (to hide secrets).
    """
    shown = display or shlex.join(cmd)
    if OPTIONS.dry_run:
        log.debug(f"[DRY-RUN] {shown}")
        return

    log.debug(f"Running modify command: {shown}")
    try:
        result = subprocess.run(cmd, check=check, capture_output=True, text=True)
        if result.stdout.strip():
            log.debug(f"stdout: {result.stdout.strip()}")
        if result.stderr.strip():
            log.debug(f"stderr: {result.stderr.strip()}")
    except subprocess.CalledProcessError as e:
        log.error(f"Modify command failed: {shown}")
        log.error(f"Exit code: {e.returncode}")
        stderr = cast(str | None, e.stderr)
        if stderr and stderr.strip():
            log.error(f"stderr: {stderr.strip()}")
        raise


def check_and_enable_systemd_service() -> None:
    """Check and enable Syncthing systemd service for current user."""
    current_user = getpass.getuser()
    service_name = "syncthing.service"
    service_user_name = f"syncthing@{current_user}.service"

    log.info(f"Checking Syncthing systemd service: {service_name}")

    try:
        # Check if service exists and is enabled (don't fail on non-zero exit code)
        result = run_query_command(
            ["sudo", "systemctl", "is-enabled", service_user_name], check=False
        )

        if result.returncode == 0:
            log.info(f"Syncthing service {service_user_name} is enabled")
            return

        log.info(f"Service {service_user_name} is disabled")

        # Check is global service is enable (Nixos)
        result = run_query_command(
            ["sudo", "systemctl", "is-enabled", service_name], check=False
        )

        if result.returncode == 0:
            log.info(f"Syncthing service {service_name} is enabled")
            return

        log.info(f"Service {service_name} is disabled")

        log.info(f"Enable {service_user_name} is disabled")
        run_modify_command(["sudo", "systemctl", "enable", service_user_name], False)
        run_modify_command(["sudo", "systemctl", "start", service_user_name], False)

    except Exception as e:
        log.error(f"- Failed to enable systemd service: {e}")
        raise


def check_syncthing_connection() -> None:
    """Check if Syncthing service is running and accessible."""
    try:
        result = run_query_command(syncthing("show", "system"))
        system_info = cast(dict[str, object], json.loads(result.stdout))
        if not system_info.get("myID"):
            raise ValueError("Could not get device ID from Syncthing")
        log.info("Syncthing service is running")
    except Exception as e:
        log.error("Syncthing service is not accessible")
        log.error(f"Error: {e}")
        log.error("Make sure Syncthing is running: systemctl --user start syncthing")
        raise


def get_hostname() -> str:
    """Get the current hostname."""
    hostname = socket.gethostname()
    log.info(f"Current hostname: {hostname}")
    return hostname


def folder_exists(folder_name: str) -> bool:
    """Check if a folder exists in Syncthing configuration."""
    try:
        result = run_query_command(syncthing("config", "folders", "list"))
        folders = result.stdout.strip().split("\n") if result.stdout.strip() else []
        return folder_name in folders
    except Exception as e:
        log.debug(f"Could not check folder list: {e}")
        return False


def device_exists(device_id: str) -> bool:
    """Check if a device exists in Syncthing configuration."""
    try:
        result = run_query_command(syncthing("config", "devices", "list"))
        return device_id in result.stdout.split()
    except Exception as e:
        log.debug(f"Could not check device list: {e}")
        return False


def add_device(device_name: str, device: Device) -> None:
    """Add a device to Syncthing configuration."""
    log.info(f"Adding device: {device_name} ({device.id})")

    try:
        run_modify_command(
            syncthing("config", "devices", "add", "--device-id", device.id)
        )
    except Exception as e:
        log.warning(f"Failed to add device {device_name}: {e}")
        # Keep going only if the device already existed
        if not device_exists(device.id):
            return

    # Set as introducer if specified (even if the device already existed)
    if device.introducer:
        try:
            run_modify_command(
                syncthing("config", "devices", device.id, "introducer", "set", "true")
            )
        except Exception as e:
            log.warning(f"Failed to set device {device_name} as introducer: {e}")


def configure_folder_settings(folder_name: str, folder_config: FolderConfig) -> None:
    """Configure folder settings (common for both new and existing folders)."""

    def folder_set(*args: str) -> None:
        run_modify_command(syncthing("config", "folders", folder_name, *args))

    # Set folder label if specified
    folder_set("label", "set", folder_config.get("label", folder_name))

    # Set rescan interval
    folder_set(
        "rescan-intervals", "set", str(folder_config.get("rescanIntervals", 3600))
    )

    # Set file watcher
    watcher = "true" if folder_config["fsWatcherEnabled"] else "false"
    folder_set("fswatcher-enabled", "set", watcher)

    # Set folder type (default is sendreceive)
    folder_set("type", "set", folder_config.get("type", "sendreceive"))

    # Set minimum free disk space to 4GB
    folder_set("min-disk-free", "value", "set", "4")
    folder_set("min-disk-free", "unit", "set", "GB")

    # Set versioning if specified
    if "versioning" in folder_config:
        versioning = folder_config["versioning"]
        folder_set("versioning", "type", "set", versioning["type"])

        # Set versioning parameters
        for param, value in versioning.get("params", {}).items():
            folder_set("versioning", "params", "set", param, value)


def create_folder(folder_name: str, folder_config: FolderConfig) -> None:
    """Create a folder in Syncthing configuration."""
    path = folder_config["path"]

    # Check if folder already exists
    if folder_exists(folder_name):
        log.info(f"Folder {folder_name} already exists, updating configuration")
        try:
            configure_folder_settings(folder_name, folder_config)
            log.debug(f"Successfully updated existing folder {folder_name}")
        except Exception as e:
            log.warning(f"Failed to update existing folder {folder_name}: {e}")
        return

    log.info(f"Creating folder: {folder_name} at {path}")

    try:
        # Create the directory if it doesn't exist
        if not OPTIONS.dry_run:
            Path(path).mkdir(parents=True, exist_ok=True)

        # Add folder
        run_modify_command(
            syncthing("config", "folders", "add", "--id", folder_name, "--path", path)
        )

        # Configure folder settings
        configure_folder_settings(folder_name, folder_config)

        log.info(f"Successfully created folder {folder_name}")

    except Exception as e:
        log.warning(f"Failed to create folder {folder_name}: {e}")


def configure_global_settings() -> None:
    """Configure global Syncthing settings."""
    log.info("Configuring global settings")

    try:
        # Enable GUI on TLS with specific address
        run_modify_command(syncthing("config", "gui", "enabled", "set", "true"))
        run_modify_command(syncthing("config", "gui", "raw-use-tls", "set", "true"))
        run_modify_command(
            syncthing("config", "gui", "raw-address", "set", "0.0.0.0:5001")
        )

        # Set GUI authentication
        run_modify_command(syncthing("config", "gui", "user", "set", "silvus"))

        # Check if password exist, set if empty
        pass_hash = run_query_command(
            syncthing("config", "gui", "password", "get"), check=False
        )
        if pass_hash.returncode != 0 or not pass_hash.stdout.strip():
            log.info("Set basic auth password")
            pwd = getpass.getpass().strip()
            if pwd:
                run_modify_command(
                    syncthing("config", "gui", "password", "set", pwd),
                    display="syncthing cli config gui password set ********",
                )
        else:
            log.debug("Basic auth password already defined")

        # Set GUI theme to black
        run_modify_command(syncthing("config", "gui", "theme", "set", "black"))

        # Set minimum free disk space to 5GB globally
        # run_modify_command(syncthing("config", "defaults", "folder", "min-disk-free", "set", "5GB"))

        # Disable anonymous usage reporting
        run_modify_command(
            syncthing("config", "options", "uraccepted", "set", "--", "-1")
        )

        # Disable browser autostart
        run_modify_command(
            syncthing("config", "options", "start-browser", "set", "false")
        )

        # Disable automatic upgrades
        run_modify_command(
            syncthing("config", "options", "auto-upgrade-intervalh", "set", "0")
        )

        log.debug("Successfully configured global settings")

    except Exception as e:
        log.warning(f"Failed to configure global settings: {e}")


def get_folder_devices(folder_name: str) -> list[str]:
    """Get list of devices currently sharing a folder."""
    try:
        result = run_query_command(
            syncthing("config", "folders", folder_name, "dump-json")
        )
        folder_config = cast(dict[str, list[dict[str, str]]], json.loads(result.stdout))
        return [device["deviceID"] for device in folder_config.get("devices", [])]
    except Exception as e:
        log.debug(f"Could not get devices for folder {folder_name}: {e}")
        return []


def share_folder_with_devices(
    folder_name: str, device_names: list[str], devices: dict[str, Device]
) -> None:
    """Share a folder with specified devices."""
    log.info(
        f"Configuring folder {folder_name} sharing with devices: {', '.join(device_names)}"
    )

    # Get currently shared devices
    current_devices = set(get_folder_devices(folder_name))

    # Get target device IDs
    target_devices: dict[str, str] = {}
    for device_name in device_names:
        if device_name in devices:
            target_devices[devices[device_name].id] = device_name
        else:
            log.error(
                f"- Unknown device: {device_name} (available: {', '.join(devices)})"
            )

    # Remove devices that are no longer in the configuration
    # `syncthing devices remove` doesn't exist
    # devices_to_remove = current_devices - target_devices.keys()
    # for device_id in devices_to_remove:
    #     try:
    #         log.debug(f"Removing device {device_id} from folder {folder_name}")
    #         run_modify_command(
    #             syncthing("config", "folders", folder_name, "devices", "remove", "--device-id", device_id)
    #         )
    #         log.info(f"+ Removed device {device_id} from folder {folder_name}")
    #     except Exception as e:
    #         log.warning(
    #             f"- Could not remove device {device_id} from folder {folder_name}: {e}"
    #         )

    # Add devices that are not already sharing
    for device_id, device_name in target_devices.items():
        if device_id in current_devices:
            continue
        try:
            log.debug(
                f"Adding device {device_name} (ID: {device_id}) to folder {folder_name}"
            )
            run_modify_command(
                syncthing(
                    "config",
                    "folders",
                    folder_name,
                    "devices",
                    "add",
                    "--device-id",
                    device_id,
                )
            )
            log.info(f"+ Added device {device_name} to folder {folder_name}")
        except Exception as e:
            log.error(
                f"- Failed to add device {device_name} to folder {folder_name}: {e}"
            )


def setup_syncthing(devices: dict[str, Device]) -> None:
    hostname = get_hostname()

    # Add all devices first
    log.info("Adding all devices")
    for device_name, device in devices.items():
        if device_name != hostname:  # Don't add ourselves
            add_device(device_name, device)

    # Configure global settings
    configure_global_settings()

    log.debug(f"Current hostname: {hostname}")

    # Create folders that this host should have
    log.info("Creating folders...")

    # # Create /data if needed
    # if not Path("/data").exists():
    #     current_user = getpass.getuser()
    #     run_modify_command(["sudo", "mkdir", "/data"])
    #     run_modify_command(["sudo", "chown", "-R", f"{current_user}:{current_user}", "/data"])

    for folder_name, folder_config in SYNCTHING_FOLDERS.items():
        log.debug(
            f"Checking folder {folder_name} with devices: {folder_config['devices']}"
        )
        if hostname in folder_config["devices"]:
            create_folder(folder_name, folder_config)
            # Share with other devices in the folder config
            other_devices = [d for d in folder_config["devices"] if d != hostname]
            log.debug(f"Other devices for {folder_name}: {other_devices}")
            if other_devices:
                share_folder_with_devices(folder_name, other_devices, devices)
            else:
                log.warning(f"No other devices to share folder {folder_name} with")
        else:
            log.debug(
                f"- Skipping folder {folder_name} (hostname '{hostname}' not in devices)"
            )


def load_devices(include_vms: bool) -> dict[str, Device]:
    """Read device IDs from the age-encrypted secrets file."""
    log.info("Reading secrets age")
    secrets_path = Path(__file__).parent.parent / "secrets" / "syncthing.age"
    result = subprocess.run(
        ["age", "-d", str(secrets_path)],
        check=True,
        stdout=subprocess.PIPE,
    )

    secrets = tomllib.loads(result.stdout.decode())
    nodes = cast(dict[str, str], secrets["nodes"])

    # Nix is the introducer
    # Hosts with "-vm" in their name are only included when `include_vms` is set
    return {
        name: Device(id=device_id, introducer=name == "nix")
        for name, device_id in nodes.items()
        if include_vms or "-vm" not in name
    }


class Args(argparse.Namespace):
    debug: bool = False


def init_cli_arg() -> Args:
    parser = argparse.ArgumentParser(prog="syncthingsetup")

    _ = parser.add_argument(
        "-d",
        "--debug",
        action="store_true",
        help='Debug flag (dry-run mode and enable "-vm" host)',
    )

    return parser.parse_args(namespace=Args())


def main() -> int:
    # Parse args
    args = init_cli_arg()
    OPTIONS.dry_run = args.debug

    log.setLevel(logging.DEBUG if OPTIONS.dry_run else logging.INFO)

    try:
        log.debug(f"Arguments: {args}")

        if OPTIONS.dry_run:
            log.info("Running in DEBUG mode (dry-run) - no commands will be executed")

        log.info("Starting Syncthing setup...")

        # Check if syncthing CLI is available
        try:
            _ = run_query_command(["syncthing", "--version"])
        except Exception as e:
            log.error("syncthing command not found. Please install Syncthing first.")
            log.error(f"Error: {e}")
            return 1

        devices = load_devices(include_vms=OPTIONS.dry_run)

        # Check and enable systemd user service if needed
        check_and_enable_systemd_service()

        # Check if Syncthing service is running and accessible
        try:
            check_syncthing_connection()
        except Exception as e:
            log.error("Cannot connect to Syncthing service.")
            log.error(f"Error: {e}")
            return 1

        # Setup Syncthing
        setup_syncthing(devices)

        log.info("Syncthing setup completed")
        return 0

    except KeyboardInterrupt:
        log.warning("Aborting...")
        return 1
    except Exception as e:
        log.error(f"Setup failed: {e}")
        if OPTIONS.dry_run:
            traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(main())
