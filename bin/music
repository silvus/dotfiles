#!/usr/bin/env bash

# If run under Tmux, set title
if [[ -n "$TMUX" ]]; then
	tmux rename-window "music"
fi

if command -v mot >/dev/null 2>&1 ; then
	mot "$@"
else
	mocp -M "$XDG_CONFIG_HOME"/moc "$@"
fi

# If run under Tmux, unset title
if [[ -n "$TMUX" ]]; then
	tmux set-window-option -q automatic-rename
fi

exit 0
