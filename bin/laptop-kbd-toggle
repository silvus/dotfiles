#!/usr/bin/env bash

# Toggle the laptop's built-in keyboard on / off.
# TrackPoint and touchpad keep working. A reboot always turns it back on.

set -euo pipefail

# Writing to the serio port needs root
if [[ $EUID -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

# The built-in keyboard's port, found by its description (stays there when disabled)
port=""
for dev in /sys/bus/serio/devices/*; do
    if [[ "$(cat "$dev/description" 2>/dev/null)" == "i8042 KBD port" ]]; then
        port=$dev
        break
    fi
done
if [[ -z "$port" ]]; then
    echo "Built-in keyboard port (i8042 KBD port) not found" >&2
    exit 1
fi

if [[ -e "$port/driver" ]]; then
    # manual: stop the kernel from re-attaching the keyboard driver on its own
    printf manual >"$port/bind_mode"
    printf none >"$port/drvctl"
else
    printf atkbd >"$port/drvctl"
    printf auto >"$port/bind_mode"
fi

# Report the real state, not the intended one (give an auto re-attach time to show)
sleep 1
if [[ -e "$port/driver" ]]; then
    echo "Laptop keyboard: enabled"
else
    echo "Laptop keyboard: disabled"
fi
