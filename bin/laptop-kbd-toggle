#!/usr/bin/env bash

# Toggle the laptop's built-in keyboard on / off (uses sudo).
# TrackPoint and touchpad keep working. A reboot always turns it back on.

set -euo pipefail

drv=/sys/bus/serio/drivers/atkbd

# The built-in keyboard's port, found by its description (stays there when disabled)
port=""
for dev in /sys/bus/serio/devices/*; do
    if [[ "$(cat "$dev/description" 2>/dev/null)" == "i8042 KBD port" ]]; then
        port=$(basename "$dev")
    fi
done
if [[ -z "$port" ]]; then
    echo "Built-in keyboard port (i8042 KBD port) not found" >&2
    exit 1
fi

if [[ -e "$drv/$port" ]]; then
    action=unbind
    msg="Disabled"
else
    action=bind
    msg="Enabled"
fi

printf '%s' "$port" | sudo tee "$drv/$action" >/dev/null
echo "Laptop keyboard: $msg"
