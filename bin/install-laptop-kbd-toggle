#!/usr/bin/env bash
# Install laptop-kbd-toggle system parts (Ubuntu laptop):
#  - root-owned copy in /usr/local/bin (pkexec and udev run this copy, never the
#    user-writable one in ~/.dotfiles)
#  - udev rule: built-in keyboard off while the external keyboard is plugged in,
#    also at boot (coldplug replays the "add" events)
# Re-run after editing bin/laptop-kbd-toggle.

set -euo pipefail

src="$(dirname "$(readlink -f "$0")")/laptop-kbd-toggle"
dest=/usr/local/bin/laptop-kbd-toggle
rules=/etc/udev/rules.d/99-laptop-kbd-toggle.rules
run="/usr/bin/systemd-run --no-block --collect $dest auto"

sudo install -m 755 -o root -g root "$src" "$dest"

# One rule per external keyboard listed in EXT_KBD_IDS (kernel PRODUCT has no leading zeros)
ids=$(sed -n 's/^EXT_KBD_IDS="\([^"]*\)".*/\1/p' "$src")
{
    echo "# Generated by install-laptop-kbd-toggle"
    echo "# External keyboard plugged / unplugged"
    for id in $ids; do
        vendor=$(echo "${id%%:*}" | sed 's/^0*//')
        product=$(echo "${id##*:}" | sed 's/^0*//')
        echo "ACTION==\"add|remove\", SUBSYSTEM==\"usb\", ENV{DEVTYPE}==\"usb_device\", ENV{PRODUCT}==\"$vendor/$product/*\", RUN+=\"$run\""
    done
    echo "# Built-in keyboard appears (boot)"
    echo "ACTION==\"add\", SUBSYSTEM==\"serio\", KERNEL==\"serio0\", RUN+=\"$run\""
} | sudo tee "$rules" >/dev/null

sudo udevadm control --reload-rules

echo "Installed: $dest, $rules"
echo "Built-in keyboard is currently: $(laptop-kbd-toggle status)"
