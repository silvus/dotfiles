            </div>
            <script>
            function toggle_table_column(col_no) {{
                var rows = document.getElementById('reporttable').rows;

                for (var row = 0; row < rows.length; row++) {{
                    var cols = rows[row].cells;
                    if (col_no >= 0 && col_no < cols.length) {{
                        cols[col_no].style.display = cols[col_no].style.display == 'none' ? '' : 'none';
                    }}
                }}
            }}
            // Sort on header click: numbers start descending, text ascending
            // Cells without data-sort value (unknown) always stay at the end
            function sort_table(header) {{
                var table = document.getElementById('reporttable');
                var tbody = table.tBodies[0];
                var col_no = header.cellIndex;
                var is_number = header.dataset.type == 'number';
                var asc = header.classList.contains('sort-desc')
                    || (!header.classList.contains('sort-asc') && !is_number);

                table.querySelectorAll('thead th').forEach(function(th) {{
                    th.classList.remove('sort-asc', 'sort-desc');
                }});
                header.classList.add(asc ? 'sort-asc' : 'sort-desc');

                var rows = Array.prototype.slice.call(tbody.rows);
                rows.sort(function(row_a, row_b) {{
                    var a = row_a.cells[col_no].dataset.sort;
                    var b = row_b.cells[col_no].dataset.sort;
                    if (a === '' || b === '') {{
                        return (a === '') - (b === '');
                    }}
                    var result = is_number ? a - b : a.localeCompare(b);
                    return asc ? result : -result;
                }});
                rows.forEach(function(row) {{
                    tbody.appendChild(row);
                }});
            }}
            document.querySelectorAll('#reporttable thead th').forEach(function(th) {{
                th.addEventListener('click', function() {{
                    sort_table(th);
                }});
            }});

            document.querySelector('#button-toggle-origin').addEventListener('click', function() {{
                toggle_table_column(4);
            }});
            document.querySelector('#button-toggle-seo').addEventListener('click', function() {{
                toggle_table_column(5);
            }});
            // Hide by default
            toggle_table_column(4);
            toggle_table_column(5);
            </script>
        </body>
    </html>
    """.format(
            self.execution_time, average_response_time
        )

        with open(self.report_html_path, "w") as report_file:
            report_file.write(html_str_start)

            # Reverse sort to have the 200 at the end
            for statuscode, urls in sorted(
                self.report_url_httpcode.items(), reverse=True
            ):
                for url in sorted(urls):
                    status_color = "error_background"
                    if statuscode == 200:
                        status_color = "success_background"
                    elif statuscode == 999:
                        status_color = "info_background"
                    elif _status_class(statuscode) == 3:
                        status_color = "warning_background"

                    source_count = len(self.report_url_origin[url])
                    if source_count < 2:
                        source_count = "{} url".format(source_count)
                    else:
                        source_count = "{} urls".format(source_count)

                    size = self.report_size.get(url)
                    seo_errors = sum(
                        1 for seo in self.report_seo[url] if not seo.is_ok
                    )

                    seo_report = ""
                    for seo in self.report_seo[url]:
                        if seo.is_ok:
                            seo_report += '<span style="color: green">✔</span> {} : {}<br />'.format(
                                html.escape(seo.title), html.escape(seo.message)
                            )
                        else:
                            seo_report += '<span style="color: red">✗</span> {} : {}<br />'.format(
                                html.escape(seo.title), html.escape(seo.message)
                            )

                    report_file.write(
                        """
                                      <tr>
                                          <td class="{status_color} text-center" data-sort="{statuscode}">{statuscode}</td>
                                          <td class="text-right" style="white-space:nowrap" data-sort="{response_time_ms}">{response_time}</td>
                                          <td class="text-right" style="white-space:nowrap" data-sort="{size_bytes}">{size}</td>
                                          <td data-sort="{url}"><a href="{url}">{url}</a></td>
                                          <td data-sort="{source_count_number}">
                                            <div style="max-height: 55px; overflow: auto;">
                                                <strong>{source_count}</strong><br />
                                                {sources}
                                            </div>
                                          </td>
                                          <td style="white-space:nowrap" data-sort="{seo_errors}">{seo_report}</td>
                                      </tr>
                                      """.format(
                            statuscode=statuscode,
                            status_color=status_color,
                            response_time_ms=round(
                                self.report_response_time[url] * 1000
                            ),
                            response_time=_format_response_time(
                                self.report_response_time[url]
                            ),
                            size_bytes="" if size is None else size,
                            size=_format_size(size),
                            url=html.escape(url),
                            source_count_number=len(self.report_url_origin[url]),
                            source_count=source_count,
                            sources="<br />".join(
                                html.escape(origin)
                                for origin in self.report_url_origin[url]
                            ),
                            seo_errors=seo_errors,
                            seo_report=seo_report,
                        )
                    )

            report_file.write(html_str_end)

        print()
        print("Html report generated {}".format(self.report_html_path))

    def print_success(self, http_code, message):
        if COLORS:
            print("[" + COLOR_GREEN + str(http_code) + COLOR_RESET + "] " + message)
        else:
            print("[" + str(http_code) + "] " + message)

    def print_info(self, http_code, message):
        if COLORS:
            print("[" + COLOR_BLUE + str(http_code) + COLOR_RESET + "] " + message)
        else:
            print("[" + str(http_code) + "] " + message)

    def print_warning(self, http_code, message):
        if COLORS:
            print("[" + COLOR_YELLOW + str(http_code) + COLOR_RESET + "] " + message)
        else:
            print("[" + str(http_code) + "] " + message)

    def print_error(self, http_code, message):
        if COLORS:
            print("[" + COLOR_RED + str(http_code) + COLOR_RESET + "] " + message)
        else:
            print("[" + str(http_code) + "] " + message)

    def log_http_code(self, http_code, url):
        if http_code:
            if http_code == 999:
                # Custom errors
                self.print_error(http_code, url)
            elif _status_class(http_code) == 2:
                self.print_success(http_code, url)
            elif _status_class(http_code) == 3:
                self.print_warning(http_code, url)
            elif _status_class(http_code) in (4, 5):
                self.print_error(http_code, url)
            else:
                self.print_error(
                    http_code, "Http return code not handle - {}".format(url)
                )
        else:
            self.print_error("???", "No http return code {}".format(url))


def init_cli_arg():

    # Parse args
    parser = argparse.ArgumentParser(description="Spider domain")
    parser.add_argument(
        "-v",
        "--version",
        action="version",
        version="%(prog)s {0}".format(__version__),
        help="show program's version number and exit",
    )
    parser.add_argument(
        "-d", "--debug", action="store_true", help="Debug flag", default=DEBUG
    )
    parser.add_argument(
        "-nc",
        "--no-colors",
        action="store_true",
        help="Disable colors",
        default=not COLORS,
    )
    parser.add_argument(
        "-w",
        "--wait",
        action="store_true",
        help="Wait before each request (random between 0.1s and 9.9s). Use 1 worker unless --workers is set",
        default=WAIT,
    )
    parser.add_argument(
        "-j",
        "--workers",
        type=int,
        help="Number of parallel requests (default: min(32, cpu + 4))",
        default=None,
    )
    parser.add_argument(
        "-m",
        "--max-pages",
        type=int,
        help="Stop adding urls after this many (default: 0, unlimited)",
        default=MAX_PAGES,
    )
    parser.add_argument(
        "-a",
        "--auth",
        help="Basic auth as user:password (or env LINKSCANNER_AUTH)",
        default=os.environ.get("LINKSCANNER_AUTH"),
    )
    parser.add_argument(
        "-r",
        "--report",
        help="HTML report path. Set to empty string to disable",
        default=os.path.join(WORKING_DIR, "linkscanner_report.html"),
    )
    parser.add_argument(
        "-s", "--seo", action="store_true", help="Active SEO analyse", default=SEO
    )
    parser.add_argument("url", type=str, help="Start url")

    return parser.parse_args()


def main():
    global DEBUG
    global COLORS
    global SEO
    global WAIT
    global MAX_PAGES
    global OPENER

    # Parse args
    args = init_cli_arg()
    DEBUG = args.debug
    COLORS = not args.no_colors  # Flag is negative, keep the opposite
    WAIT = args.wait
    SEO = args.seo
    MAX_PAGES = args.max_pages
    workers = args.workers
    if WAIT and workers is None:
        workers = 1
    report_html_path = args.report

    if report_html_path:
        # Convert HTML report path to absolute
        report_html_path = os.path.abspath(os.path.expanduser(report_html_path))

    log.setLevel(logging.DEBUG if DEBUG else logging.INFO)

    OPENER = build_opener(args.url, args.auth)

    try:
        report = Report(args.url, datetime.now(), report_html_path)
        report = launch_spider(args.url, report, workers)

        report.build_report()
        report.build_report_cli()

        if report_html_path:
            report.build_report_html()
        else:
            log.debug("HTML report disable")

    except KeyboardInterrupt:
        sys.exit(1)

    return 0


if __name__ == "__main__":
    sys.exit(main())
